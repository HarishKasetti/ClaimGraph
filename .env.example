# MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/claimgraph

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Semantic Scholar API key (https://api.semanticscholar.org/)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# OpenAlex polite pool email (https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication)
OPENALEX_EMAIL=your_email@example.com

# Ollama base URL for local LLM inference
OLLAMA_BASE_URL=http://localhost:11434
